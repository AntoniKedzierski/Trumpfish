{
  "openapi": "3.1.1",
  "info": {
    "title": "Trumpfish.Server | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bidding-systems": {
      "get": {
        "tags": [
          "BiddingSystems"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BiddingSystemSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bidding-systems/{name}": {
      "get": {
        "tags": [
          "BiddingSystems"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BiddingSystem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "BiddingSystems"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BiddingSystem"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BiddingSystem"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BiddingSystem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BiddingSystemSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "BiddingSystems"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content",
            "content": {
              "application/json": { }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/bidding-systems/validate": {
      "post": {
        "tags": [
          "BiddingSystems"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BiddingSystem"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/BiddingSystem"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/BiddingSystem"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ValidationIssue"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BidColor": {
        "enum": [
          "NoColor",
          "Clubs",
          "Diamonds",
          "Hearts",
          "Spades",
          "NoTrump"
        ]
      },
      "BiddingGoal": {
        "type": "integer"
      },
      "BiddingSystem": {
        "type": "object",
        "properties": {
          "systemName": {
            "type": "string"
          },
          "roots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Root"
            }
          }
        }
      },
      "BiddingSystemSummary": {
        "required": [
          "name",
          "rootCount",
          "bidCount",
          "modifiedUtc"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "rootCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "bidCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "modifiedUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BidNode": {
        "type": "object",
        "properties": {
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "condition": {
            "type": [
              "null",
              "string"
            ]
          },
          "convention": {
            "type": [
              "null",
              "string"
            ]
          },
          "pointsRange": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NumberRange"
              }
            ]
          },
          "spadesCardRange": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NumberRange"
              }
            ]
          },
          "heartsCardRange": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NumberRange"
              }
            ]
          },
          "diamondsCardRange": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NumberRange"
              }
            ]
          },
          "clubsCardRange": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NumberRange"
              }
            ]
          },
          "spadesStops": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "heartsStops": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "diamondsStops": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "clubsStops": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "colorDistribution": {
            "type": [
              "null",
              "string"
            ]
          },
          "aces": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "kings": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "openerBid": {
            "type": "boolean"
          },
          "signOff": {
            "type": "boolean"
          },
          "oneRoundForcing": {
            "type": "boolean"
          },
          "gameForcing": {
            "type": "boolean"
          },
          "automaticResponse": {
            "type": "boolean"
          },
          "goToOpenings": {
            "type": "boolean"
          },
          "nextBids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BidNode"
            }
          },
          "realizedGoal": {
            "$ref": "#/components/schemas/BiddingGoal"
          },
          "aiSource": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "$ref": "#/components/schemas/BidType"
          },
          "color": {
            "$ref": "#/components/schemas/BidColor"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isFromSystem": {
            "type": "boolean"
          }
        }
      },
      "BidType": {
        "enum": [
          "Pass",
          "Submit",
          "Double",
          "Redouble"
        ]
      },
      "NumberRange": {
        "type": "object",
        "properties": {
          "lower": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "upper": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Root": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "bids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BidNode"
            }
          }
        }
      },
      "ValidationIssue": {
        "required": [
          "severity",
          "message",
          "path"
        ],
        "type": "object",
        "properties": {
          "severity": {
            "$ref": "#/components/schemas/ValidationSeverity"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "conventionContext": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ValidationSeverity": {
        "enum": [
          "Info",
          "Warning",
          "Error"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "BiddingSystems"
    }
  ]
}