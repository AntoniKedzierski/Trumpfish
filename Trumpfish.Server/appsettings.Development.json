{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    // A Debug build runs on a throwaway in-memory database, so no PostgreSQL has to be installed to work on the application.
    // Set this to false to develop against the connection string below instead - the only way to exercise the migrations.
    "UseInMemory": true
  },
  "ConnectionStrings": {
    "Trumpfish": "Host=localhost;Port=5432;Database=trumpfish;Username=postgres;Password=postgres"
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "admin"
  }
}
