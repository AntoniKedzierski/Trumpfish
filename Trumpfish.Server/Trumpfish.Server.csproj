<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\Trumpfish.WebClient</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:62850</SpaProxyServerUrl>

    <!-- Emit the OpenAPI document into the web client so TypeScript models can be generated from it.
         Generation is opt-in because the tooling starts the full host, which costs a few seconds on every build and in CI.
         Regenerate with: dotnet build Trumpfish.Server -p:OpenApiGenerateDocumentsOnBuild=true
         A Debug build starts on its in-memory database, so this no longer needs PostgreSQL to be running. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\Trumpfish.WebClient\src\api</OpenApiDocumentsDirectory>

    <!-- Visual Studio Container Tools. The Dockerfile lives at the repository root because it copies both Model and the web client,
         so the build context has to be the solution folder rather than the project folder. -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileFile>..\Dockerfile</DockerfileFile>
    <DockerfileContext>..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.4" />
  </ItemGroup>

  <!-- The curated systems ship with the server: a deployed instance applies them over its database on every start. -->
  <ItemGroup>
    <Content Update="Seed\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The double dummy solver is a native library built out of https://github.com/dds-bridge/dds - see native\README.md for how
       to produce it. Both platforms are copied straight into the output folder rather than under runtimes\<rid>\native, because
       nothing writes these into deps.json: the default probing only finds a native library next to the application itself.
       Every file is optional. A working copy without them builds and runs exactly as before, with the analysis endpoint
       reporting itself unavailable, which is also what a developer who never touches that feature should get. -->
  <ItemGroup>
    <None Include="..\native\win-x64\dds.dll" Link="dds.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\native\win-x64\dds.dll')" />
    <None Include="..\native\linux-x64\libdds.so" Link="libdds.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\native\linux-x64\libdds.so')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Model\Model.csproj" />

    <!-- The JavaScript SDK is not available inside the .NET SDK container image, and the container build supplies its own SPA output. -->
    <ProjectReference Include="..\Trumpfish.WebClient\Trumpsfish.WebClient.esproj" Condition="'$(SkipSpaBuild)' != 'true'" />
  </ItemGroup>

  <!-- Folds the production SPA bundle into wwwroot of the published output, so a single site serves both the API and the client from the same origin.
       Set SkipSpaBuild=true to reuse an existing dist folder instead of invoking npm; the container build uses this to keep Node out of the SDK image. -->
  <Target Name="PublishSpa" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" Condition="'$(SkipSpaBuild)' != 'true' and !Exists('$(SpaRoot)\node_modules')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" Condition="'$(SkipSpaBuild)' != 'true'" />
    <Error Text="The SPA output folder '$(SpaRoot)\dist' does not exist. Run 'npm run build' in $(SpaRoot) or omit SkipSpaBuild." Condition="!Exists('$(SpaRoot)\dist')" />
    <ItemGroup>
      <SpaDistFiles Include="$(SpaRoot)\dist\**" />
      <ResolvedFileToPublish Include="@(SpaDistFiles->'%(FullPath)')">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
