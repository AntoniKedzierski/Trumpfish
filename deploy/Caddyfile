# The host name comes from the environment so this file needs no editing when the machine is rebuilt under another name.
# Caddy obtains and renews the certificate itself over ACME; port 80 has to stay open for the challenge even though every
# request that arrives on it is redirected to 443.
{$TRUMPFISH_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# WebSockets for the SignalR hub pass through untouched. The X-Forwarded-Proto that Caddy adds is what the server's
	# UseForwardedHeaders reads, which is how the cookie ends up marked Secure and the HTTPS redirect stops looping.
	reverse_proxy app:8080 {
		# No buffering: the hub keeps its connection open and must not wait for a buffer to fill.
		flush_interval -1
	}
}
