# Copy to .env on the server, fill in, then: chmod 600 .env
# The real .env is git ignored on purpose - it is the only place these secrets exist.

# Public name of the host. Caddy asks for a certificate for exactly this name, and the server refuses any other Host header.
TRUMPFISH_HOSTNAME=trumpfish.polandcentral.cloudapp.azure.com

# Image to run. Pulled from the registry - never built on the host, which has too little memory for it.
TRUMPFISH_IMAGE=ghcr.io/antonikedzierski/trumpfish:latest

# Database password. Generate one and never reuse it: openssl rand -base64 24
POSTGRES_PASSWORD=

# The bootstrap administrator the server creates on an empty database. Leaving the password unset means it falls back to the
# built in development value, which is "admin".
ADMIN_USERNAME=antoni
ADMIN_PASSWORD=
